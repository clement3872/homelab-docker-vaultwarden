# ── Image ────────────────────────────────────────────────
# https://github.com/dani-garcia/vaultwarden/releases
VAULTWARDEN_TAG=1.37.5

# ── Networking ───────────────────────────────────────────
VAULTWARDEN_PORT=9003
DOMAIN=https://vault.example.com
AUTH_HOST=auth.example.com
# Caddy sets X-Forwarded-For, not the default X-Real-IP.
IP_HEADER=X-Forwarded-For

# ── Accounts ─────────────────────────────────────────────
SIGNUPS_ALLOWED=true          # flip to false after the first login
INVITATIONS_ALLOWED=false
# Left empty on purpose: any domain accepted. Setting this caused the
# "Email domain not allowed" failure on the previous attempt.
SIGNUPS_DOMAINS_WHITELIST=

# ── Admin page ───────────────────────────────────────────
# argon2 hash, single-quoted. See README step 2.
ADMIN_TOKEN=

# ── SSO (Authentik) — enabled in phase 2, not at first boot ──
SSO_ENABLED=false
SSO_ONLY=false
SSO_AUTHORITY=https://auth.example.com/application/o/vaultwarden/
SSO_SCOPES=openid profile email offline_access
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_PKCE=true
SSO_SIGNUPS_MATCH_EMAIL=true
SSO_ALLOW_UNKNOWN_EMAIL_VERIFICATION=false
SSO_CLIENT_CACHE_EXPIRATION=600

# ── Logging ──────────────────────────────────────────────
LOG_LEVEL=info
